{
  "name": "dsh-proton",
  "version": "0.1.3",
  "description": "质子 —— DSH 的通用 Region / Renderer / Decorator 运行时（不含任何产品域语义）",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChenXu233/dsh-proton.git"
  },
  "homepage": "https://github.com/ChenXu233/dsh-proton#readme",
  "type": "module",
  "license": "Apache-2.0",
  "main": "lib/index.js",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./src/client/index.ts",
      "default": "./lib/client.js"
    }
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "engines": {
      "dsh": ">=0.2.2-rc.1"
    },
    "client": {
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "react": "^18.2.0",
    "@deepseek-ai/dsh-client-store": "^0.2.2-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.1",
    "@testing-library/react": "^16.3.0",
    "jsdom": "^27.0.0",
    "react-dom": "^18.3.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-store": "0.2.2-rc.1"
  },
  "engines": {
    "node": ">=20"
  }
}
