{
  "name": "dsh-proton-workspace",
  "version": "0.1.5",
  "description": "质子 · 工作区域：目录流的选择与接纳，来源由任意 backend 通过 ctx.protonWorkspace 注册",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChenXu233/dsh-proton.git"
  },
  "homepage": "https://github.com/ChenXu233/dsh-proton#readme",
  "type": "module",
  "license": "Apache-2.0",
  "main": "lib/index.js",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./src/client/index.tsx",
      "default": "./lib/client.js"
    },
    "./services": {
      "types": "./src/client/services.ts"
    }
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "engines": {
      "dsh": ">=0.2.2-rc.1"
    },
    "client": {
      "platform": "web",
      "inject": [
        "dsh-proton",
        "dsh-proton-adapter-dsh"
      ]
    }
  },
  "dependencies": {
    "dsh-proton": "workspace:*",
    "dsh-proton-adapter-dsh": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@testing-library/react": "^16.3.0",
    "jsdom": "^27.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
